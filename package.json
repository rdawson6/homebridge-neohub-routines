  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md"
  ]
}
