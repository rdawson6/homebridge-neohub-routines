{
  "name": "homebridge-neohub-routines",
  "version": "0.1.0",
  "displayName": "Heatmiser neoHub Routines",
  "description": "Homebridge plugin that runs Heatmiser neoHub routines (recipes) from HomeKit over the hub's local API, and exposes each zone's temperature as a HomeKit sensor.",
  "license": "MIT",
  "author": {
    "name": "Rich Dawson",
    "url": "https://github.com/rdawson6"
  },
  "contributors": [
    {
      "name": "Kiro AI",
      "url": "https://kiro.dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rdawson6/homebridge-neohub-routines"
  },
  "homepage": "https://github.com/rdawson6/homebridge-neohub-routines#readme",
  "bugs": {
    "url": "https://github.com/rdawson6/homebridge-neohub-routines/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
